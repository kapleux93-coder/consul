# ============================================================
# Consul — конфигурация. Скопируйте в .env и заполните.
#   cp .env.example .env
# ============================================================

# ОБЯЗАТЕЛЬНО: ключ Groq — https://console.groq.com/keys
GROQ_API_KEY=

# ОБЯЗАТЕЛЬНО: токен бота Consul из @BotFather (/newbot).
# Из этого бота пользователи открывают мини-апп.
BOT_TOKEN=

# Заполнится автоматически при `npm run setup`.
BOT_USERNAME=

# Публичный https-адрес сервиса. На Render/Railway/Fly определяется сам —
# указывайте только при своём хостинге.
# PUBLIC_URL=https://consul.example.com

# Адрес есть, но сообщения всё равно забирать опросом Telegram.
# Нужно, когда сервер живёт за туннелем на ноутбуке: после сна вебхуки
# теряются навсегда, а опрос восстанавливается сам.
# FORCE_POLLING=1

# ------------------------------------------------------------
# Необязательное
# ------------------------------------------------------------

# Ключ шифрования токенов ботов: openssl rand -hex 32
# Без него создаётся data/.enc-key рядом с базой.
# CONSUL_ENC_KEY=

# Конкретная модель Groq. По умолчанию выбирается доступная автоматически.
# Посмотреть список: npm run models
# GROQ_MODEL=llama-3.3-70b-versatile

# Лимиты — защита вашего ключа от одного слишком активного кабинета.
# LIMIT_DAILY_AI=300         # ответов AI в сутки на кабинет
# LIMIT_DAILY_GLOBAL=5000    # ответов AI в сутки на весь сервис
# LIMIT_CHAT_PER_MIN=6       # сообщений от одного клиента в минуту
# LIMIT_KB_CHARS=300000      # объём базы знаний на кабинет

# Резервные копии стора.
# BACKUP_KEEP=7            # сколько копий хранить
# BACKUP_EVERY_HOURS=24    # как часто копировать
# BACKUP_FIRST_MINUTES=10  # первая копия после запуска на свежей установке

# Ваш Telegram id — откроет /api/admin/stats со сводкой по всем кабинетам.
# ADMIN_IDS=

# Ссылки в разделе More.
# PRIVACY_URL=
# TERMS_URL=
# SUPPORT_URL=
